+/* NexMon injection workqueue */
+struct nexmon_inject_work {
+        struct work_struct work;
+        struct sk_buff *skb;
+        dhd_info_t *dhd;
+        int ifidx;
+};
+
+static void
+nexmon_inject_worker(struct work_struct *work)
+{
+        struct nexmon_inject_work *nw =
+                container_of(work, struct nexmon_inject_work, work);
+        struct nexmon_inject_frame *frm;
+        wl_ioctl_t ioc;
+        int frame_len, total_len, ret;
+
+        frame_len = nw->skb->len;
+        total_len = sizeof(struct nexmon_inject_frame) + frame_len;
+
+        frm = (struct nexmon_inject_frame *) kmalloc(total_len, GFP_KERNEL);
+        if (!frm) {
+                DHD_ERROR(("NexMon: worker kmalloc failed\n"));
+                goto out;
+        }
+
+        frm->len = (unsigned short)total_len;
+        frm->pad = 0;
+        frm->type = 1;
+        memcpy(frm->data, nw->skb->data, frame_len);
+
+        memset(&ioc, 0, sizeof(ioc));
+        ioc.cmd = NEX_INJECT_FRAME;
+        ioc.buf = (char *)frm;
+        ioc.len = total_len;
+        ioc.set = 1;
+
+        DHD_OS_WAKE_LOCK(&nw->dhd->pub);
+        ret = dhd_wl_ioctl(&nw->dhd->pub, nw->ifidx, &ioc, ioc.buf, ioc.len);
+        DHD_OS_WAKE_UNLOCK(&nw->dhd->pub);
+
+        DHD_ERROR(("NexMon: injected frame_len=%d ret=%d\n", frame_len, ret));
+
+        kfree(frm);
+out:
+        dev_kfree_skb_any(nw->skb);
+        kfree(nw);
+}
+
+static int
+nexmon_inject_frame(struct sk_buff *skb, struct net_device *net)
+{
+        struct nexmon_inject_work *nw;
+        dhd_info_t *dhd = DHD_DEV_INFO(net);
+        int ifidx;
+
+        ifidx = dhd_net2idx(dhd, net);
+        if (ifidx == DHD_BAD_IF) {
+                DHD_ERROR(("NexMon: bad ifidx\n"));
+                dev_kfree_skb_any(skb);
+                return NETDEV_TX_OK;
+        }
+
+        nw = (struct nexmon_inject_work *) kmalloc(sizeof(*nw), GFP_ATOMIC);
+        if (!nw) {
+                DHD_ERROR(("NexMon: work alloc failed\n"));
+                dev_kfree_skb_any(skb);
+                return NETDEV_TX_OK;
+        }
+
+        nw->skb = skb;
+        nw->dhd = dhd;
+        nw->ifidx = ifidx;
+        INIT_WORK(&nw->work, nexmon_inject_worker);
+        schedule_work(&nw->work);
+
+        return NETDEV_TX_OK;
+}
